# Скопируйте в .env и заполните. .env в git не попадает.

# Ссылка проекта Supabase (Project ref) и пароль БД — для `supabase link` / `supabase db push`.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Фронтенд (публичные значения): URL проекта и publishable key (sb_publishable_...).
# Эти же две переменные задаются в Vercel → Settings → Environment Variables.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Только для scripts/seed.ts и scripts/security-check.ts. НЕ для фронтенда, НЕ в Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Пароль трёх демо-пользователей, которых создаёт scripts/seed.ts. Придумайте сами.
SEED_PASSWORD=
